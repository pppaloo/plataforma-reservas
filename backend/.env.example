# ---------------------------------------------------------------------------
# Copia este archivo como .env y completa los valores.
# NUNCA subas el .env real al repositorio.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# MongoDB Atlas (usuario de aplicacion con rol readWrite SOLO sobre esta base)
MONGODB_URI=mongodb+srv://USUARIO_APP:CLAVE@cluster0.xxxxx.mongodb.net/reservas?retryWrites=true&w=majority

# Secretos JWT: minimo 32 caracteres aleatorios cada uno.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=cambia_este_valor_por_uno_aleatorio_de_32_o_mas
JWT_REFRESH_SECRET=cambia_este_otro_valor_por_uno_aleatorio_de_32_o_mas
JWT_ACCESS_TTL=15m
JWT_REFRESH_DAYS=7

# Origen(es) autorizados del frontend, separados por coma.
# En desarrollo: http://localhost:5173
# En produccion: https://tu-app.onrender.com
CLIENT_ORIGIN=http://localhost:5173

# SameSite de la cookie de refresh:
#   lax  -> frontend y backend en el mismo dominio (recomendado)
#   none -> frontend y backend en dominios distintos (exige HTTPS)
COOKIE_SAMESITE=lax

# SMTP para el formulario de contacto.
# Si se deja vacio, los correos se omiten y solo se registra en consola.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ReservaPro <no-reply@tudominio.cl>
MAIL_INSTITUTIONAL_TO=contacto@tudominio.cl

# Credenciales iniciales del administrador (usadas solo por "npm run seed").
# CAMBIAR antes de desplegar.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@reservapro.cl
ADMIN_PASSWORD=CambiarEstaClave123!
